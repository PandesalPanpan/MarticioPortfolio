# Copy this file to `.env` and fill in your real key (`.env` is gitignored).
# Powers the "Ask about Peter" chatbot (server-side proxy only — never exposed to the browser).
#
# Local dev: read by the Vite dev middleware in vite.config.ts.
# Production: set the SAME variable in Netlify → Site settings → Environment variables.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
